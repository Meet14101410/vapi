    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vapi City Information - The Industrial Hub</title>
    <style>
        body { 
            font-family: 'Roboto', sans-serif; 
            line-height: 1.6; 
            margin: 0; 
            padding: 0; 
            background-color: #f0f4f7; /* Light industrial background */
            color: #333; 
        }
        .container { 
            max-width: 800px; 
            margin: 30px auto; 
            padding: 30px; 
            background: white; 
            border-radius: 10px; 
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); 
        }
        header {
            background-color: #007bff; /* Primary Blue */
            color: white;
            padding: 25px;
            text-align: center;
            border-radius: 8px 8px 0 0;
            margin: -30px -30px 20px -30px;
        }
        header h1 {
            margin: 0;
            font-size: 2.2em;
        }
        h2 {
            color: #007bff;
            border-bottom: 3px solid #ced4da;
            padding-bottom: 8px;
            margin-top: 25px;
        }
        .fact-box {
            background: #e9f7ff; /* Very light blue */
            padding: 18px;
            border-left: 5px solid #0056b3;
            margin-bottom: 25px;
            border-radius: 8px;
        }
        .sector-list {
            list-style: none;
            padding: 0;
        }
        .sector-list li {
            padding: 15px;
            margin-bottom: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff;
        }
        .sector-list strong {
            display: block;
